{
  "version": "1.0",
  "rules": {
    "include": [
      ".claude/rules/*.md",
      ".claude/rules/features/*.md"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-docs-updated.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/inject-doc-rule.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-sql-readonly.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__search_docs"
    ]
  }
}
